# Зависимости
node_modules/
.pnp/
.pnp.js

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Переменные окружения
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# G2: без wildcard-строки ниже `.env.production` НЕ игнорировался —
# паттерн `.env` матчит только файл с именем ровно `.env`, поэтому реальный
# прод-файл с секретами уходил бы в коммит. `.example`-шаблоны остаются
# отслеживаемыми (см. !-правила).
.env.production
.env.*.local
# Шаблоны остаются отслеживаемыми (negation без `/` действует на любом уровне).
!**/.env.example
!**/.env.production.example

# Сборка
dist/
build/
.next/
out/

# Prisma
backend/prisma/migrations/
!backend/prisma/migrations/README.md

# Загруженные файлы
backend/uploads/
!backend/uploads/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Тестирование
coverage/
.nyc_output/

# Временные файлы
