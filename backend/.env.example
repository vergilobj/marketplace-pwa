# База данных
DATABASE_URL=postgresql://market_user:***@localhost:5432/marketplace

# Тестовая БД (L1-ФИКС). Интеграционные спеки (`*.integration.spec.ts`,
# `*.spec.ts` с реальным PrismaService, `test/*.e2e-spec.ts`) ходят СЮДА, а не
# в боевую `marketplace`. Отдельная БД, а не схема, потому что Prisma-миграции
# и `_prisma_migrations` привязаны к БД целиком.
#
# Если переменная НЕ задана — тесты продолжат работать против DATABASE_URL
# (как раньше), но jest напечатает предупреждение «изоляция не включена».
# Если она совпадает с DATABASE_URL — изоляция тоже не включится.
#
# Подготовка (один раз, идемпотентно):
#   bash backend/scripts/setup-test-db.sh
TEST_DATABASE_URL=postgresql://market_user:***@localhost:5432/marketplace_test

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# OneSignal (пуши)
VITE_ONESIGNAL_APP_ID=

# NowPayments (crypto payments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=https://your-domain.com/payments/ipn
NOWPAYMENTS_SANDBOX=true

# Paymod (crypto sidecar, локальный HTTP + HMAC)
PAYMOD_SHARED_SECRET=change-me-paymod-shared-secret
PAYMOD_SIDECAR_URL=http://127.0.0.1:8100

# Загрузки
UPLOAD_BASE_URL=

# Redis (для Bull очередей)
REDIS_URL=redis://localhost:6379
