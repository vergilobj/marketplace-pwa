# База данных
DATABASE_URL=postgresql://market_user:***@localhost:5432/marketplace

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# CometChat
VITE_COMETCHAT_APP_ID=
VITE_COMETCHAT_AUTH_KEY=
VITE_COMETCHAT_REGION=us
COMETCHAT_WEBHOOK_SECRET=

# OneSignal (пуши)
VITE_ONESIGNAL_APP_ID=

# NowPayments (crypto payments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=https://your-domain.com/payments/ipn
NOWPAYMENTS_SANDBOX=true

# Загрузки
UPLOAD_BASE_URL=

# Redis (для Bull очередей)
REDIS_URL=redis://localhost:6379
