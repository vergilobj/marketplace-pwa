# База данных
DATABASE_URL=postgresql://market_user:***@localhost:5432/marketplace

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# OneSignal (пуши)
VITE_ONESIGNAL_APP_ID=

# NowPayments (crypto payments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=https://your-domain.com/payments/ipn
NOWPAYMENTS_SANDBOX=true

# Paymod (crypto sidecar, локальный HTTP + HMAC)
PAYMOD_SHARED_SECRET=change-me-paymod-shared-secret
PAYMOD_SIDECAR_URL=http://127.0.0.1:8100

# Загрузки
UPLOAD_BASE_URL=

# Redis (для Bull очередей)
REDIS_URL=redis://localhost:6379
