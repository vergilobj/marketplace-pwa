{
  "moduleFileExtensions": [
    "ts",
    "js",
    "json"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "globalSetup": "<rootDir>/jest-global-setup.ts",
  "globalTeardown": "<rootDir>/jest-global-teardown.ts",
  "setupFiles": [
    "<rootDir>/jest-setup-env.ts"
  ]
}
