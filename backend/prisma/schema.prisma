generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  phone         String   @unique
  name          String?
  role          UserRole @default(BUYER)
  invitedById   String?
  invitedBy     User?    @relation("UserInvited", fields: [invitedById], references: [id])
  invitedUsers  User[]   @relation("UserInvited")
  referralCode  String   @unique
  bonusBalance  Float    @default(0)
  isApproved    Boolean  @default(false)
  passwordHash  String?
  cometChatUid  String?  @unique
  chatPublicKey String?
  walletAddress String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sentInvites        Invite[]            @relation("InviteOwner")
  usedInvite         Invite?             @relation("InviteUsedBy")
  products           Product[]
  ordersBuyer        Order[]             @relation("Buyer")
  ordersSeller       Order[]             @relation("Seller")
  referralOrders     Order[]             @relation("Referral")
  postsAuthored      Post[]              @relation("PostAuthor")
  postsOwnedAd       Post[]              @relation("PostAdOwner")
  likes              Like[]
  comments           Comment[]
  notifications      Notification[]
  withdrawalRequests WithdrawalRequest[]
  sentMessages       ChatMessage[]       @relation("Sender")
  receivedMessages   ChatMessage[]       @relation("Receiver")
  avatar             String?
  auditLogs          AuditLog[]
}

enum UserRole {
  BUYER
  SELLER
  MODERATOR
  ADMIN
}

model Invite {
  code      String    @id @default(uuid())
  ownerId   String
  owner     User      @relation("InviteOwner", fields: [ownerId], references: [id])
  usedById  String?   @unique
  usedBy    User?     @relation("InviteUsedBy", fields: [usedById], references: [id])
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Product {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  media       String[]
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id             String      @id @default(uuid())
  buyerId        String
  buyer          User        @relation("Buyer", fields: [buyerId], references: [id])
  sellerId       String
  seller         User        @relation("Seller", fields: [sellerId], references: [id])
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id])
  amount         Float
  status         OrderStatus @default(PENDING)
  referralUserId String?
  referralUser   User?       @relation("Referral", fields: [referralUserId], references: [id])
  referralBonus  Float       @default(0)
  platformFee    Float       @default(0)
  transactionId  String?     @unique
  paidAt         DateTime?
  createdAt      DateTime    @default(now())

  post         Post?
  transactions Transaction[]
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model Post {
  id           String    @id @default(uuid())
  title        String
  content      String?
  link         String?
  media        Json?
  videoUrl     String?
  authorId     String
  author       User      @relation("PostAuthor", fields: [authorId], references: [id])
  isAd         Boolean   @default(false)
  adOwnerId    String?
  adOwner      User?     @relation("PostAdOwner", fields: [adOwnerId], references: [id])
  adExpireDate DateTime?
  isPinned     Boolean   @default(false)
  isHidden     Boolean   @default(false)
  orderId      String?   @unique
  order        Order?    @relation(fields: [orderId], references: [id])
  createdAt    DateTime  @default(now())
  likes        Like[]
  comments     Comment[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

enum PaymentProvider {
  NOWPAYMENTS
  PAYMOD
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  SWEPT
  FAILED
}

model Transaction {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  type           String
  amount         Float
  status         String
  payload        Json?
  provider       PaymentProvider @default(NOWPAYMENTS)
  clientRef      String?         @unique
  depositAddress String?
  chain          String?
  token          String?
  txHash         String?         @unique
  amountRaw      String?
  createdAt      DateTime        @default(now())
}

model ModerationLog {
  id        String   @id @default(uuid())
  chatMsgId String
  reason    String
  action    String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // "order", "like", "comment"
  message   String
  relatedId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum PayoutStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model WithdrawalRequest {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  amount         Float
  status         String           @default("pending") // pending, approved, rejected
  toAddress      String?
  provider       PaymentProvider? @default(PAYMOD)
  idempotencyKey String?          @unique
  payoutTxHash   String?
  payoutStatus   PayoutStatus     @default(PENDING)
  payoutError    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("Sender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  text       String?
  ciphertext String?
  fileUrl    String?
  fileName   String?
  fileType   String?
  fileSize   Int?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // 'login', 'register', 'create_order', 'delete_post', etc.
  entity    String? // 'user', 'order', 'post', 'product'
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
}
