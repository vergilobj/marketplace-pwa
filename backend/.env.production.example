# =============================================================================
# backend/.env.production.example
#
# ШАБЛОН прод-окружения бэкенда. Секретов здесь НЕТ — только плейсхолдеры.
#
#   cp backend/.env.production.example backend/.env.production
#   # заполнить <...>, файл НЕ коммитить (backend/.env.production в .gitignore)
#
# Список ключей собран grep-ом по коду, а не по памяти:
#   grep -rn "process\.env" backend/src/
#   grep -rn "config\(Service\)\?\.get" backend/src/
# Итого 23 ключа, которые реально читает бэкенд + 2 ключа канала алертов.
# Полная таблица с адресами чтения — DEPLOY.md §4.1.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Прод-режим обязателен: от него зависит CORS-дефолт в main.ts:25
# (в production при пустом CORS_ORIGIN кросс-домен выключается целиком).
NODE_ENV=production

# Порт HTTP-сервера. За nginx — 3000 (systemd bazar-node.service, DEPLOY.md §3).
PORT=3000

# --- База данных -------------------------------------------------------------
# Postgres. Формат: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
#   Hetzner  → localhost:5435 (docker marketplace-db)
#   REG.RU   → 127.0.0.1:15432 (через SSH-туннель, DEPLOY.md §4)
# Читается напрямую из process.env (prisma/schema.prisma: env("DATABASE_URL"))
# и прокидывается в child-env admin.service.ts:130.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:<DB_PORT>/<DB_NAME>?schema=public

# --- Redis (Bull-очереди) ----------------------------------------------------
#   Hetzner  → redis://localhost:6380
#   REG.RU   → redis://127.0.0.1:16379 (через туннель)
REDIS_URL=redis://127.0.0.1:<REDIS_PORT>

# --- CORS --------------------------------------------------------------------
# ОБЯЗАТЕЛЕН в проде. При пустом значении и NODE_ENV=production origin=false,
# т.е. браузерные запросы с фронта отбиваются. Прод-домен (punycode).
CORS_ORIGIN=https://<PROD_DOMAIN>

# --- JWT ---------------------------------------------------------------------
# Секреты подписи токенов. Сгенерировать: openssl rand -base64 48
# JWT_ACCESS_SECRET читается в auth/auth.module.ts + users/users.module.ts
# (валидация стратегии), JWT_REFRESH_SECRET — в auth/auth.service.ts.
JWT_ACCESS_SECRET=<RANDOM_LONG_SECRET>
JWT_REFRESH_SECRET=<RANDOM_LONG_SECRET>

# --- Paymod sidecar (BSC USDT) ----------------------------------------------
# ⚠️ САМАЯ ЧАСТАЯ ОШИБКА ДЕПЛОЯ (DEPLOY.md §5.2).
# Самидкар слушает 127.0.0.1:8100 у себя на узле. Если NestJS запущен НЕ на
# том же узле (REG.RU), локального :8100 там нет и будет ECONNREFUSED —
# ходить надо на порт SSH-туннеля:
#   Hetzner  → http://127.0.0.1:8100   (sidecar рядом, systemd paymod.service)
#   REG.RU   → http://127.0.0.1:18100  (через bazar-tunnel, НЕ 8100)
# Без working sidecar оплата не работает вообще.
PAYMOD_SIDECAR_URL=http://127.0.0.1:8100

# HMAC-SHA256 между NestJS и сайдкаром. ДОЛЖЕН совпадать с
# paymod-sidecar/.env:PAYMOD_SHARED_SECRET, иначе webhook молча отбивается 401.
PAYMOD_SHARED_SECRET=<RANDOM_LONG_SECRET>

# --- Нейро-слой «Базар» (Hermes API Server) ---------------------------------
#   Hetzner  → http://127.0.0.1:8642/v1
#   REG.RU   → http://127.0.0.1:18642/v1 (через туннель)
BAZAR_API_URL=http://127.0.0.1:<BAZAR_PORT>/v1
# Ключ Hermes API Server. Пустая строка = модерация/арбитраж уходят в
# fallback-allow (moderation.service.ts:48).
BAZAR_API_KEY=<HERMES_API_KEY>
# Профиль Hermes, которым отвечает нейро-слой. Дефолт в коде — 'bazar'.
BAZAR_MODEL=bazar
# Таймауты арбитража Базара (bazar/deal-timeout.service.ts).
BAZAR_DEAL_TIMEOUT_DAYS=7
BAZAR_ACCEPTED_TIMEOUT_HOURS=24

# --- Загрузки ----------------------------------------------------------------
# Публичный префикс ссылок на /uploads. В проде ОБЯЗАН быть прод-домен,
# иначе картинки ломаются (upload.service.ts:9,14).
UPLOAD_BASE_URL=https://<PROD_DOMAIN>

# --- OneSignal (push) --------------------------------------------------------
# ⚠️ ЗАГЛУШКА `test` = пуш МЁРТВ. Сервис теперь пишет WARN при старте
# (notifications.service.ts), но пуши появятся только с реальным UUID.
#
# Где взять реальный App ID:
#   OneSignal Dashboard → выбранное приложение → Settings → Keys & IDs
#   → "OneSignal App ID" (UUID вида xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
#
# Известное прод-значение задокументировано в DEPLOY.md §4.1 (там же —
# оно же инлайнится во фронт как VITE_ONESIGNAL_APP_ID при сборке).
# Значение из кода/репозитория в прод НЕ подставлять вслепую — сверить
# с дашбордом: app_id мог быть пересоздан.
ONESIGNAL_APP_ID=<ONESIGNAL_APP_UUID>
ONESIGNAL_REST_API_KEY=<ONESIGNAL_REST_API_KEY>

# --- NowPayments (вторичный провайдер) --------------------------------------
# Дефолтный провайдер — paymod (BSC USDT). NowPayments включается настройкой
# payment_provider в БД (settingsService.get('payment_provider') || 'paymod').
# Эти ключи читаются getOrThrow при старте NowPaymentsProvider — пустыми их
# оставлять нельзя, даже если провайдер не активен.
NOWPAYMENTS_API_KEY=<NOWPAYMENTS_API_KEY>
NOWPAYMENTS_IPN_SECRET=<NOWPAYMENTS_IPN_SECRET>
# Публичный URL IPN-колбэка.
NOWPAYMENTS_IPN_URL=https://<PROD_DOMAIN>/payments/ipn
# 'true' — sandbox-эндпоинты. В проде обязательно false.
NOWPAYMENTS_SANDBOX=false

# --- CometChat (чат) ---------------------------------------------------------
# Все три читаются через getOrThrow — приложение НЕ поднимется без них.
COMETCHAT_APP_ID=<COMETCHAT_APP_ID>
COMETCHAT_REGION=<COMETCHAT_REGION>
COMETCHAT_REST_API_KEY=<COMETCHAT_REST_API_KEY>

# --- Внешний канал алертов (G2) ---------------------------------------------
# Куда слать алерты о нарушениях денежных инвариантов, недоплатах,
# расхождениях эскроу и застрявших выплатах. Раньше алерт = logger.error +
# Notification админам в БД: если админ не залогинился — алерт утонул.
#
# Принимающая сторона — любой HTTP-эндпоинт, читающий JSON:
#   Slack/Discord webhook, n8n, self-hosted коллектор, Hermes-роут.
# Тело: { source, severity, code, message, context, timestamp }
#
# ПУСТО / НЕ ЗАДАН → тихий fallback: алерты остаются в логе и в /notifications,
# ничего не падает и в сеть не ходит. Так же ведёт себя локальная разработка.
ALERT_WEBHOOK_URL=

# Дедуп внешних алертов, минуты. Cron инвариантов крутится раз в 10 минут и
# детектит одну и ту же проблему на каждом прогоне — без дедупа канал получал
# бы 144 одинаковых сообщения в сутки. 0 — выключить дедуп.
ALERT_DEDUP_MINUTES=60

# =============================================================================
# НЕ читается бэкендом — только фронтенд (Vite инлайнит при СБОРКЕ фронта).
# Держим здесь для полноты картины; менять их в backend/.env.production
# бессмысленно — они должны быть в frontend/.env.production и применяются
# через пересборку фронта, а не рестарт бэкенда.
# =============================================================================
# VITE_ONESIGNAL_APP_ID=<ONESIGNAL_APP_UUID>   # обязан совпадать с ONESIGNAL_APP_ID
# VITE_COMETCHAT_APP_ID=<COMETCHAT_APP_ID>
# VITE_COMETCHAT_REGION=<COMETCHAT_REGION>
# VITE_COMETCHAT_AUTH_KEY=<COMETCHAT_AUTH_KEY>
# VITE_SOCKET_URL=https://<PROD_DOMAIN>