# paymod sidecar — пример окружения (НЕ коммитить реальные значения).
# Реальные ключи лежат в /opt/marketplace/paymod/.env (chmod 600, user paymod).

# --- секреты paymod (НЕ в NestJS .env, не в git, не в логах) ---
DISTRIBUTOR_SEED=""
DISTRIBUTOR_PRIVKEY=""
MAIN_WALLET_ADDRESS=""
USER_WALLET_DERIVATION_PATH="m/44'/60'/0'/0'/{index}'"
ANKR_RPC_KEY=""
DB_PATH=/opt/marketplace/paymod/paymod.db
DB_ALLOW_CREATE=1
MIN_DEPOSIT_USD=5

# --- общий секрет подписи (должен совпадать с NestJS PAYMOD_SHARED_SECRET) ---
PAYMOD_SHARED_SECRET=""

# --- конфигурация sidecar ---
# Абсолютный путь к модулю paymod (chain.py, db.py, wallets.py, ...)
PAYMOD_DIR=/opt/marketplace/paymod
# Куда слать webhook о депозитах/свипах (NestJS)
PAYMOD_WEBHOOK_URL=http://127.0.0.1:3000/payments/paymod/webhook
# Запускать фоновые watcher+sweeper (1 = да)
PAYMOD_BACKGROUND=1
# SQLite-файл sidecar-таблиц (derived_wallets, payouts)
SIDECAR_DB_PATH=/opt/marketplace/paymod/sidecar.db